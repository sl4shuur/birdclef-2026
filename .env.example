# Settings use the BCLEF_ prefix and __ for nested fields.
# Relative paths are resolved from the project root.
BCLEF_APP_NAME=birdclef

# Logging
BCLEF_LOGGING__DIRECTORY=logs
BCLEF_LOGGING__LEVEL=INFO
BCLEF_LOGGING__FORMATTER=ColoredFormatter
BCLEF_LOGGING__DATE_FORMAT="%d-%m-%Y %H:%M:%S"
BCLEF_LOGGING__FULL_COLOR=true
BCLEF_LOGGING__INCLUDE_FUNCTION=true
BCLEF_LOGGING__SUCCESS_LEVEL=69

# Data and run artifacts
BCLEF_DATA__COMPETITION_DIR=data/competition
BCLEF_DATA__OUTPUT_DIR=outputs

# Validation split
BCLEF_SPLIT__VALIDATION_FRACTION=0.2
BCLEF_SPLIT__SEED=42
# Optional: uncomment and set a column name to split by group.
# BCLEF_SPLIT__GROUP_COLUMN=filename
BCLEF_SPLIT__STRATIFY=false

# Experiment tracking
BCLEF_TRACKING__PROJECT=birdclef-2026
# BCLEF_TRACKING__ENTITY=your-team
BCLEF_TRACKING__OFFLINE=false
BCLEF_TRACKING__API_KEY="your-api-key"

# Data loaders
BCLEF_LOADER__BATCH_SIZE=128
BCLEF_LOADER__VAL_BATCH_SIZE=32
BCLEF_LOADER__PREDICT_BATCH_SIZE=32
BCLEF_LOADER__NUM_WORKERS=0
BCLEF_LOADER__PIN_MEMORY=false
BCLEF_LOADER__SEED=0
BCLEF_LOADER__SOUNDSCAPE_PROBABILITY=0.1

# Learning rate scheduler
BCLEF_LR_SCHEDULER__NAME=none
# Cosine scheduler
BCLEF_LR_SCHEDULER__T_MAX=10
BCLEF_LR_SCHEDULER__MIN_LR=0.0
# Plateau scheduler
BCLEF_LR_SCHEDULER__FACTOR=0.1
BCLEF_LR_SCHEDULER__PATIENCE=2
# Monitor: loss or other metric
BCLEF_LR_SCHEDULER__MONITOR=val/loss
BCLEF_LR_SCHEDULER__MODE=min

# Training (metric mode: min for losses/errors, max for accuracy or ranking scores)
BCLEF_TRAIN__MAX_EPOCHS=10
BCLEF_TRAIN__SEED=42
BCLEF_TRAIN__CHECKPOINT_METRIC=val/loss
BCLEF_TRAIN__CHECKPOINT_MODE=min
BCLEF_TRAIN__CHECKPOINT_TOP_K=1
BCLEF_TRAIN__EARLY_STOPPING_PATIENCE=3
BCLEF_TRAIN__ACCUMULATE_GRAD_BATCHES=1
BCLEF_TRAIN__GRADIENT_CLIP_VAL=1.0
BCLEF_TRAIN__LOG_EVERY_N_STEPS=10

# Runtime
BCLEF_RUNTIME__ACCELERATOR=auto
BCLEF_RUNTIME__DEVICES=auto
BCLEF_RUNTIME__PRECISION=auto
